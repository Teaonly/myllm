; ---- PLE 投影（第 1 层专属 6 个，共 ≈63 MB；残差更新 R += hidden+gated+conv，
;      跳过它算的是另一个模型——Strata gate C1 的教训）。注意还差三样：
;      28.8GB 巨表 per_layer_token_embd（00002 分片，按需读）、prefill 的
;      PLE 台阶（≈138 KB/token，Strata 从空闲 scratch 滚子批，见 session 区）----
'blk.1.ple_conv1d.weight'     dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (4, 10240)  F16
'blk.1.ple_key.weight'        dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (2560,10240) BF16  50 MB
'blk.1.ple_norm_conv.weight'  dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (10240,)    F32
'blk.1.ple_norm_key.weight'   dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (10240,)    F32
'blk.1.ple_norm_query.weight' dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (10240,)    F32
'blk.1.ple_value.weight'      dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (2560,2560) BF16  12.5 MB

;
;   系统核心配置
;


2048    "CS"  !    ; Prefill Chunk Size
131072  "MC"  !    ; 最大上下文长度，128K
1       'DT'  !    ; decode 每步 token 数（投机解码接入时可调大）
4       "SS"  !    ; CPU 上保存最新四份 Session 计算状态

; ---- 几何常量（公式原料，数字进 hash，下文 @ 出来算）----
2560  'N'  !    ; n_embd
4     'HC' !    ; 残差流条数
10240 'D'  !    ; HC*N，残差栈一行宽
320   'LR' !    ; hc 低秩瓶颈宽
10    'K'  !    ; 每 token 路由专家数
512   'NE' !    ; 专家总数
10240 'C'  !    ; GDN conv 通道数（q|k|v 连排）
6144  'ZV' !    ; GDN value_dim（= QSA attn 宽 24×256）
12288 'QW' !    ; QSA q 宽（24 头 × 2×256，q|gate 连排）
2051  'SEL' !   ; QSA 选择宽 = idx_top_k + idx_block − 1 = 2048+4−1（qsa.hpp qsa_selection_width）

12   'QL' !    ; QSA 全注意力层数（(层号+1)%4==0）
36   'GL' !    ; GDN 线性注意力层数
2    'KH' !    ; QSA kv 头数（GQA 24:2）
256  'HD' !    ; QSA 头宽
512  'KW' !    ; KH*HD：单份 K（或 V）每 cell 宽
128  'S'  !    ; GDN 状态维（key/value 头宽同）
48   'VH' !    ; GDN value 头数
4    'IB' !    ; indexer 池化块长（每 4 cell 一个键）
128  'ID' !    ; indexer 键宽

; ============================================================================
; 全局常驻变量 —— Prefill & Decode 共享使用
; ============================================================================

248320 4 * cuda.alloc 'next.logits' !          ; VOCAB f32 末行 logits（argmax 出 next token）

; ============================================================================
; Prefill 激活缓冲 —— 全部随 CS 线性伸缩（字节 = 宽度 × CS × 元素大小）
; ============================================================================

; ---- 每token账：残差 134K + GDN 143K + QSA 90K + MoE 196K ≈ 563 KB ----
; ---- （MoE 含 parts T×K×N=100K/token，初版账漏了它）----
; ---- CS=2048 时合计约 1.24 GiB（残差/超连接 264 MiB + GDN 330 MiB + ----
; ---- QSA 173 MiB + MoE 471 MiB）；稳定后可把三组暂存 ----
; ---- 合并成 max() 一块轮用，省约一半 ----

; 残差栈 / 超连接
'CS' @  'D'  @ * 4 * cuda.alloc 'pf.R'      !  ; 残差栈本体 (CS, hc, N) f32
'CS' @  'D'  @ * 2 * cuda.alloc 'pf.xn16'   !  ; norm 后各流的 bf16 像（参考契约）
'CS' @  'HC' @ * 4 * cuda.alloc 'pf.grs'    !  ; norm 行尺度 (CS,HC) f32——gr_mix_r 按同序复算 xn（Strata F-1：省整块 f32 xn）
'CS' @  'LR' @ * 4 * cuda.alloc 'pf.lo'     !  ; 低秩瓶颈 f32
'CS' @  'LR' @ * 2 * cuda.alloc 'pf.lo16'   !  ; 低秩瓶颈 bf16 像（参考契约，up 投影吃它）
'CS' @  'D'  @ * 4 * cuda.alloc 'pf.gated'  !  ; xn·sigmoid(gate)
'CS' @  'HC' @ * 4 * cuda.alloc 'pf.inj'    !  ; 每流注入（两半段先后复用）
'CS' @  'N'  @ * 4 * cuda.alloc 'pf.mixed'  !  ; 均值后的 mixer 输入
'CS' @  'N'  @ * 2 * cuda.alloc 'pf.mixed16' ! ; router 契约 / bf16 GEMM（α/β 投影）的 bf16 像
'CS' @  'N'  @ * 2 * cuda.alloc 'pf.mixedh' ! ; f16 GEMM（qkv/gate/out 投影）的 f16 像
'CS' @  'N'  @ * 4 * cuda.alloc 'pf.emb'    !  ; 本块 embedding（块输出 bo 与之别名）

; GDN 层暂存
'CS' @  'C'  @ * 4 * cuda.alloc 'pf.gdn.qkv'   !  ; qkv 投影出 = conv 入参
'CS' @  'C'  @ * 4 * cuda.alloc 'pf.gdn.h'     !  ; conv→SiLU→L2 后的 q|k|v
'CS' @  'ZV' @ * 4 * cuda.alloc 'pf.gdn.z'     !  ; gate 投影出（输出门）
'CS' @  'VH' @ 2 * * 4 * cuda.alloc 'pf.gdn.ab'   !  ; α|β 合排 (CS,2·VH)，ldy=2VH 交错写
'CS' @  'VH' @ * 4 * cuda.alloc 'pf.gdn.gate' !  ; 递归门 (CS,VH)
'CS' @  'VH' @ * 4 * cuda.alloc 'pf.gdn.beta' !  ; 递归 β (CS,VH)
'CS' @  'ZV' @ * 4 * cuda.alloc 'pf.gdn.o'     !  ; 递归输出（norm 前 y）
'CS' @  'ZV' @ * 2 * cuda.alloc 'pf.gdn.y16'   !  ; norm 后 y 的 f16 像（out 投影入参）
'C'  @  'N'  @ * 2 * cuda.alloc 'pf.gdn.w16'   !  ; 量化权重反量化 f16 scratch（固定 50 MiB，不随 CS；qkv/gate/out 同流先后复用）

; QSA 层暂存
'CS' @  'QW' @ * 4 * cuda.alloc 'pf.qsa.q'     !  ; q|gate 连排
'CS' @  1024  * 4 * cuda.alloc 'pf.qsa.kv'     !  ; k、v 各 512 宽合一块
'CS' @  'ZV' @ * 4 * cuda.alloc 'pf.qsa.attn'  !  ; gate 前注意力输出
'CS' @  128   * 4 * cuda.alloc 'pf.qsa.idxk'   !  ; indexer 原始键（norm 前）
'CS' @  512   * 4 * cuda.alloc 'pf.qsa.qidx'  !  ; indexer 查询向量（4 头 × 128，norm 后）
'CS' @  'SEL' @ * 4 * cuda.alloc 'pf.qsa.ids'  !  ; 选中 cell 号 int32

; MoE 暂存（do_moe_layer 契约：ids/w/slot/src 四表 + 收行 xs + 逐专家行缓冲；
; dqgu/dqd 是反量化 scratch，不随 CS——逐专家现解现用）
'CS' @  'NE' @ * 4 *       cuda.alloc 'pf.moe.logits' !  ; 路由 logits (CS,NE) f32
'CS' @  'K'  @ * 4 *       cuda.alloc 'pf.moe.ids'    !  ; top-k 专家 id (CS,K) int32
'CS' @  'K'  @ * 4 *       cuda.alloc 'pf.moe.w'      !  ; 选中集归一权重 (CS,K) f32
'CS' @  'K'  @ * 4 *       cuda.alloc 'pf.moe.slot'   !  ; 分组表 (t,k)→Dm 行 int32
'CS' @  'K'  @ * 4 *       cuda.alloc 'pf.moe.src'    !  ; 分组表 Dm 行→token int32
'CS' @  'K'  @ * 'N'  @ * 2 * cuda.alloc 'pf.moe.xs'   !  ; 收行后的混合输入 (CS·K,N) f16
'CS' @  'K'  @ * 1280 * 4 * cuda.alloc 'pf.moe.gu'     !  ; gate|up 交错行 (CS·K,2·640) f32
'CS' @  'K'  @ * 640  * 2 * cuda.alloc 'pf.moe.h'      !  ; SwiGLU 中间 (CS·K,640) f16
'CS' @  'K'  @ * 'N'  @ * 4 * cuda.alloc 'pf.moe.parts' !  ; 各专家输出 (CS·K,N) f32，combine 的输入——MoE 最大一项
'N' @ 1280 * 2 *           cuda.alloc 'pf.moe.dqgu'   !  ; 专家 gate|up 反量化 f16 (1280,N)——down GEMM 前作废
'N' @ 640 * 2 *            cuda.alloc 'pf.moe.dqd'    !  ; down 反量化 f16（共享 up/共享 down/逐专家 down 轮用）
'CS' @  640 * 4 *          cuda.alloc 'pf.moe.sgate'  !  ; 共享专家 gate 投影 (CS,640) f32
'CS' @  640 * 4 *          cuda.alloc 'pf.moe.sup'    !  ; 共享专家 up 投影 (CS,640) f32
'CS' @  640 * 2 *          cuda.alloc 'pf.moe.shH16'  !  ; 共享专家 SwiGLU 中间 (CS,640) f16（down 投影入参）
'CS' @  'N'  @ * 4 *       cuda.alloc 'pf.moe.out'    !  ; 共享专家输出=combine 原地 (CS,N) f32
'CS' @  4 *                cuda.alloc 'pf.moe.shg'    !  ; 共享专家标量门 f32（每 token 一个）


; ============================================================================
; Decode 激活缓冲 —— cuda.view 从 prefill 缓冲借 T 行，零新增显存
; ============================================================================


; ============================================================================
; Session 常驻状态 —— 单 session、最大 MC=128000，跨 chunk/token 持久
; ============================================================================

; ---- QSA KV cache（12 层）----
2 'KVE' !    ; KV 元素字节：2=FP16（默认）

;; 整片的Session相关内存，依次 View ，先创建 4G ，不够增加
4 1024 * 1024 * 1024 * cuda.alloc "session.cuda" !

0 'offset' !

; 必须是起始，Host直接用0地址写数据
"session.cuda" @ 'offset' @
    'MC' @ 4 * cuda.view 'cache.ids' !                       
'offset' @ 'MC' @ 4 * + 'offset' ! 

"session.cuda" @ 'offset' @
    'QL' @ 'MC' @ * 'KW' @ * 'KVE' @ * cuda.view 'cache.K' !    ; (QL, MC, KW) K 池
'offset' @ 'QL' @ 'MC' @ * 'KW' @ * 'KVE' @ * + 'offset' !   ; offset += 一池字节

"session.cuda" @ 'offset' @
    'QL' @ 'MC' @ * 'KW' @ * 'KVE' @ * cuda.view 'cache.V' !    ; (QL, MC, KW) V 池
'offset' @ 'QL' @ 'MC' @ * 'KW' @ * 'KVE' @ * + 'offset' !   ; 后续 GDN/QSA 状态接着排

; ---- GDN 递归状态（36 层，FP32 契约）——S 矩阵与 conv 历史分列两块 ----
; gdn.S    每层 786'432 f32（VH×128×128，每 v-head 一张 K×V 状态矩阵）
; gdn.conv 每层 3×10240 f32：卷积前 qkv 输入的最近 3 行 

"session.cuda" @ 'offset' @
    'VH' @ 'S' @ * 'S' @ * 'GL' @ * 4 * cuda.view 'gdn.S' !
'offset' @ 'VH' @ 'S' @ * 'S' @ * 'GL' @ * 4 * + 'offset' !   ; +108 MiB

"session.cuda" @ 'offset' @
    'C' @ 3 * 'GL' @ * 4 * cuda.view 'gdn.conv' !
'offset' @ 'C' @ 3 * 'GL' @ * 4 * + 'offset' !                ; +4.2 MiB；session.cuda 还剩 ~0.96 GiB 给 rope 表/PLE

'offset' !!                                                  ; 临时量出hash：后续状态接着排时再立

; 主机端配置多分Session内存，届时一次 H2D 复制完成
"session.cuda" @ tensor.size "SSIZE" !
"SSIZE" @ "SS" @ * host.alloc "staff.sessions" !

; ============================================================================
; 同步内存 —— host↔device 采用
; 
; ============================================================================
4 host.alloc "staff.targetSession" !
4 host.alloc "staff.inputLeft" !
4 host.alloc "staff.inputRight" !

16 4 * host.alloc "staff.ioTokens" !
4 host.alloc "staff.outputNumber" !
4 host.alloc "staff.outputCmd" !


; ---- 收尾：路径出栈，排空 H2D，报个到 ----
drop
cuda.sync
'qwen3.8-next loaded: 1079 dense weights (token_embd IQ4_XS embed + output Q6_K head, untied; PLE proj in; table on-demand) + memory resident' ?
