; ============================================================================
; qwen3.8-next.vt —— Qwen3.8-Flash-Next 常驻小权重装载剧本（vt DSL）
;
; main 直接加载本剧本，装完进入 command loop 逐行执行 vt 指令（REPL）。
;
; 内存模型参照 Strata run-iq3_s.sh：小权重（attention/ssm/超连接/共享专家/
; 路由/output_hc）全数常驻显存；大块不装，留给后续按需路径——
;     per_layer_token_embd.weight         PLE 巨表 28.8GB（在 00002 分片）
;     blk.*.ffn_*_exps.weight             MOE 专家（48 层 × 3）
; 词表矩阵（token_embd/output）模型层 weight-tied；pack 里是同源两种量化
; （output=Q6_K 497MiB，token_embd=IQ4_XS 322MiB），装高精度 Q6_K 一份、
; 两个名字共用（embedding 侧吃到更高精度的同一矩阵，省 322MiB）。
; 注意：'token_embd.weight' @ 取到的块按 Q6_K 解码，勿按 GGUF 目录的 IQ4_XS。
;
; 装载模式（路径常驻栈底，逐张量复用；三步：探尺寸 → 分配 → 装入）：
;     '名字' dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
;   dup2 dup2       ( path name -- path name path name path name )  两个副本：probe、load 各吃一份
;   gguf.probe      ( path name -- n )      探字节数
;   cuda.alloc      ( n -- tensor )         显存块（host.alloc 则落主机锁页）
;   gguf.load       ( path name dst -- dst ) 装入（dev 异步 H2D / host 直拷）
;   swap !          ( tensor name -- ) 存进 hash；path 留栈
; 装完 drop 掉路径。合计 1078 个 =
;   3 顶层 output_hc + 1 词表矩阵(双名字一份显存) + 6 PLE 投影(blk.1)
;   + 48 层 × 13 公共 + 36 GDN 层 × 9 + 12 全注意力层 × 10
; ============================================================================

; ---- 模型路径（文件头直接设定；dup 一份进 hash 留档，REPL 里 'model.gguf' @ 随取）----
'/home/teaonly/workspace/models/qwen3.8-flash-gsq/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf' dup 'model.gguf' !

; ---- 顶层 output_hc（3 个）----
'output_hc_down.weight'  dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'output_hc_norm.weight'  dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'output_hc_up.weight'    dup2 dup2 gguf.probe cuda.alloc gguf.load swap !

; ---- 词表矩阵（Q6_K 一份显存，双名字；weight-tied，见文件头注释）----
'output.weight'      dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; 解嵌入 = Q6_K ≈497 MiB
'output.weight' @ 'token_embd.weight' !    ; embedding 同一块显存的第二个名字（按 Q6_K 解码）

; ---- 48 层公共：FFN 共享专家 + 路由 + 超连接（13 个/层）----
%for 0 47
'blk.%%.ffn_down_shexp.weight'     dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.ffn_gate_inp.weight'       dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.ffn_gate_inp_shexp.weight' dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.ffn_gate_shexp.weight'     dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.ffn_up_shexp.weight'       dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.hc_attn_down.weight'       dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.hc_attn_inject.weight'     dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.hc_attn_norm.weight'       dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.hc_attn_up.weight'         dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.hc_ffn_down.weight'        dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.hc_ffn_inject.weight'      dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.hc_ffn_norm.weight'        dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.hc_ffn_up.weight'          dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
%endf

