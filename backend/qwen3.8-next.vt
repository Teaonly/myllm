; ---- PLE 投影（第 1 层专属 6 个，共 ≈63 MB；残差更新 R += hidden+gated+conv，
;      跳过它算的是另一个模型——Strata gate C1 的教训）。注意还差三样：
;      28.8GB 巨表 per_layer_token_embd（00002 分片，按需读）、prefill 的
;      PLE 台阶（≈138 KB/token，Strata 从空闲 scratch 滚子批，见 session 区）----
'blk.1.ple_conv1d.weight'     dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (4, 10240)  F16
'blk.1.ple_key.weight'        dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (2560,10240) BF16  50 MB
'blk.1.ple_norm_conv.weight'  dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (10240,)    F32
'blk.1.ple_norm_key.weight'   dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (10240,)    F32
'blk.1.ple_norm_query.weight' dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (10240,)    F32
'blk.1.ple_value.weight'      dup2 dup2 gguf.probe cuda.alloc gguf.load swap !   ; (2560,2560) BF16  12.5 MB

;
;   系统核心配置
;


2048    "CS"  !    ; Prefill Chunk Size
128000  "MC"  !    ; 最大上下文长度
1       'DT'  !    ; decode 每步 token 数（投机解码接入时可调大）
4       "SS"  !    ; CPU 上保存最新四份 Session 计算状态

; ---- 几何常量（公式原料，数字进 hash，下文 @ 出来算）----
2560  'N'  !    ; n_embd
4     'HC' !    ; 残差流条数
10240 'D'  !    ; HC*N，残差栈一行宽
320   'LR' !    ; hc 低秩瓶颈宽
10    'K'  !    ; 每 token 路由专家数
512   'NE' !    ; 专家总数
10240 'C'  !    ; GDN conv 通道数（q|k|v 连排）
6144  'ZV' !    ; GDN value_dim（= QSA attn 宽 24×256）
12288 'QW' !    ; QSA q 宽（24 头 × 2×256，q|gate 连排）
2051  'SEL' !   ; QSA 选择宽 = idx_top_k + idx_block − 1 = 2048+4−1（qsa.hpp qsa_selection_width）

12   'QL' !    ; QSA 全注意力层数（(层号+1)%4==0）
36   'GL' !    ; GDN 线性注意力层数
2    'KH' !    ; QSA kv 头数（GQA 24:2）
256  'HD' !    ; QSA 头宽
512  'KW' !    ; KH*HD：单份 K（或 V）每 cell 宽
128  'S'  !    ; GDN 状态维（key/value 头宽同）
48   'VH' !    ; GDN value 头数
4    'IB' !    ; indexer 池化块长（每 4 cell 一个键）
128  'ID' !    ; indexer 键宽

; ============================================================================
; 全局常驻变量 —— Prefill & Decode 共享使用
; ============================================================================

248320 4 * cuda.alloc 'next.logits' !          ; VOCAB f32 末行 logits（argmax 出 next token）

; ============================================================================
; Prefill 激活缓冲 —— 全部随 CS 线性伸缩（字节 = 宽度 × CS × 元素大小）
; ============================================================================

; ---- 每token账：残差 129K + GDN 143K + QSA 90K + MoE 196K ≈ 558 KB ----
; ---- （MoE 含 parts T×K×N=100K/token，初版账漏了它）----
; ---- CS=2048 时合计约 1.1 GiB；稳定后可把 GDN/QSA/MoE 三组暂存 ----
; ---- 合并成 max() 一块轮用，省约一半 ----

; 残差栈 / 超连接
'CS' @  'D'  @ * 4 * cuda.alloc 'pf.R'      !  ; 残差栈本体 (CS, hc, N) f32
'CS' @  'D'  @ * 2 * cuda.alloc 'pf.xn16'   !  ; norm 后各流的 bf16 像（参考契约）
'CS' @  'LR' @ * 4 * cuda.alloc 'pf.lo'     !  ; 低秩瓶颈 f32
'CS' @  'LR' @ * 2 * cuda.alloc 'pf.lo16'   !  ; 低秩瓶颈 bf16 像（参考契约，up 投影吃它）
'CS' @  'D'  @ * 4 * cuda.alloc 'pf.gated'  !  ; xn·sigmoid(gate)
'CS' @  'HC' @ * 4 * cuda.alloc 'pf.inj'    !  ; 每流注入（两半段先后复用）
'CS' @  'N'  @ * 4 * cuda.alloc 'pf.mixed'  !  ; 均值后的 mixer 输入
'CS' @  'N'  @ * 2 * cuda.alloc 'pf.mixed16' ! ; router 契约 / f16 GEMM 的 bf16 像（纯 f32 GEMM 可省）
'CS' @  'N'  @ * 4 * cuda.alloc 'pf.emb'    !  ; 本块 embedding（块输出 bo 与之别名）

; GDN 层暂存
'CS' @  'C'  @ * 4 * cuda.alloc 'pf.gdn.h'     !  ; conv→SiLU 后的 q|k|v
'CS' @  'C'  @ * 4 * cuda.alloc 'pf.gdn.conv'  !  ; conv1d 输出（h 的前身）
'CS' @  'ZV' @ * 4 * cuda.alloc 'pf.gdn.o'     !  ; 递归步输出
'CS' @  'ZV' @ * 4 * cuda.alloc 'pf.gdn.z'     !  ; 输出门 z
'CS' @  'ZV' @ * 2 * cuda.alloc 'pf.gdn.y16'   !  ; norm 后 y 的 bf16 像

; QSA 层暂存
'CS' @  'QW' @ * 4 * cuda.alloc 'pf.qsa.q'     !  ; q|gate 连排
'CS' @  1024  * 4 * cuda.alloc 'pf.qsa.kv'     !  ; k、v 各 512 宽合一块
'CS' @  'ZV' @ * 4 * cuda.alloc 'pf.qsa.attn'  !  ; gate 前注意力输出
'CS' @  128   * 4 * cuda.alloc 'pf.qsa.idxk'   !  ; indexer 原始键（norm 前）
'CS' @  512   * 4 * cuda.alloc 'pf.qsa.qidx'  !  ; indexer 查询向量（4 头 × 128，norm 后）
'CS' @  'SEL' @ * 4 * cuda.alloc 'pf.qsa.ids'  !  ; 选中 cell 号 int32

; MoE 暂存
'CS' @  'NE' @ * 4 *       cuda.alloc 'pf.moe.logits' !  ; 路由 logits
'CS' @  'K'  @ * 8 *       cuda.alloc 'pf.moe.idsw'    !  ; top-k id(int32)+权重(f32) 同块
'CS' @  'K'  @ * 1280 * 4 * cuda.alloc 'pf.moe.gu'     !  ; 激活后 gate|up 行
'CS' @  'K'  @ * 640  * 4 * cuda.alloc 'pf.moe.h'      !  ; SwiGLU 中间
'CS' @  'K'  @ * 'N'  @ * 4 * cuda.alloc 'pf.moe.parts' !  ; 各专家输出 (CS,K,N)，combine 的输入——MoE 最大一项
'CS' @  'N'  @ * 4 *       cuda.alloc 'pf.moe.out'     !  ; combine（共享专家原地）
'CS' @  640 * 4 * cuda.alloc 'pf.moe.shH'   !  ; 共享专家 SwiGLU 中间 f32（gate|up 可原地）
'CS' @  640 * 2 * cuda.alloc 'pf.moe.shH16' !  ; 共享专家 down 入参 bf16 像（契约）
'CS' @  4 *       cuda.alloc 'pf.moe.shg'   !  ; 共享专家标量门 f32（每 token 一个）


; ============================================================================
; Decode 激活缓冲 —— cuda.view 从 prefill 缓冲借 T 行，零新增显存
; ============================================================================
; prefill 与 decode 在同一 default stream 上先后执行（服务循环串行拍），decode
; 每步的 scratch 直接切 prefill 块的首 'DT' 行视图，不另开显存；宽度公式与
; pf.* 一一对应，只是 CS 换成 DT。
; 每序列常驻的递归状态（GDN S / conv 状态 / QSA KV cache）不在此——见下方
; "Session 常驻状态"一节（原设计文档 §10 的布局由该节落地）。

; 残差栈 / 超连接
'pf.R'      @ 0 'DT' @ 'D'  @ * 4 * cuda.view 'dec.R'      !  ; 残差栈行
'pf.xn16'   @ 0 'DT' @ 'D'  @ * 2 * cuda.view 'dec.xn16'   !  ; norm 后 bf16 像
'pf.lo'     @ 0 'DT' @ 'LR' @ * 4 * cuda.view 'dec.lo'     !  ; 低秩瓶颈
'pf.lo16'   @ 0 'DT' @ 'LR' @ * 2 * cuda.view 'dec.lo16'   !  ; 低秩瓶颈 bf16 像
'pf.gated'  @ 0 'DT' @ 'D'  @ * 4 * cuda.view 'dec.gated'  !  ; xn·sigmoid(gate)
'pf.inj'    @ 0 'DT' @ 'HC' @ * 4 * cuda.view 'dec.inj'    !  ; 每流注入
'pf.mixed'  @ 0 'DT' @ 'N'  @ * 4 * cuda.view 'dec.mixed'  !  ; mixer 输入
'pf.mixed16' @ 0 'DT' @ 'N'  @ * 2 * cuda.view 'dec.mixed16' ! ; router bf16 像
'pf.emb'    @ 0 'DT' @ 'N'  @ * 4 * cuda.view 'dec.emb'    !  ; embedding 行

; GDN 层暂存
'pf.gdn.h'    @ 0 'DT' @ 'C'  @ * 4 * cuda.view 'dec.gdn.h'    !
'pf.gdn.conv' @ 0 'DT' @ 'C'  @ * 4 * cuda.view 'dec.gdn.conv' !
'pf.gdn.o'    @ 0 'DT' @ 'ZV' @ * 4 * cuda.view 'dec.gdn.o'    !
'pf.gdn.z'    @ 0 'DT' @ 'ZV' @ * 4 * cuda.view 'dec.gdn.z'    !
'pf.gdn.y16'  @ 0 'DT' @ 'ZV' @ * 2 * cuda.view 'dec.gdn.y16'  !

; QSA 层暂存
'pf.qsa.q'    @ 0 'DT' @ 'QW' @ * 4 * cuda.view 'dec.qsa.q'     !  ; q|gate 连排
'pf.qsa.kv'   @ 0 'DT' @ 1024 * 4 *    cuda.view 'dec.qsa.kv'   !  ; k、v 各 512 合一块
'pf.qsa.attn' @ 0 'DT' @ 'ZV' @ * 4 *  cuda.view 'dec.qsa.attn' !
'pf.qsa.idxk' @ 0 'DT' @ 128 * 4 *     cuda.view 'dec.qsa.idxk' !  ; indexer 原始键
'pf.qsa.qidx' @ 0 'DT' @ 512 * 4 *     cuda.view 'dec.qsa.qidx' !  ; indexer 查询向量
'pf.qsa.ids'  @ 0 'DT' @ 'SEL' @ * 4 * cuda.view 'dec.qsa.ids'  !  ; 选中 cell 号

; MoE 暂存
'pf.moe.logits' @ 0 'DT' @ 'NE' @ * 4 *      cuda.view 'dec.moe.logits' !
'pf.moe.idsw'   @ 0 'DT' @ 'K' @ * 8 *       cuda.view 'dec.moe.idsw'   !
'pf.moe.gu'     @ 0 'DT' @ 'K' @ * 1280 * 4 * cuda.view 'dec.moe.gu'     !
'pf.moe.h'      @ 0 'DT' @ 'K' @ * 640  * 4 * cuda.view 'dec.moe.h'      !
'pf.moe.out'    @ 0 'DT' @ 'N' @ * 4 *       cuda.view 'dec.moe.out'    !
'pf.moe.parts'  @ 0 'DT' @ 'K' @ * 'N' @ * 4 * cuda.view 'dec.moe.parts'  !
'pf.moe.shH'    @ 0 'DT' @ 640 * 4 *         cuda.view 'dec.moe.shH'    !
'pf.moe.shH16'  @ 0 'DT' @ 640 * 2 *         cuda.view 'dec.moe.shH16'  !
'pf.moe.shg'    @ 0 'DT' @ 4 *               cuda.view 'dec.moe.shg'    !

; ============================================================================
; Session 常驻状态 —— 单 session、最大 MC=128000，跨 chunk/token 持久
; ============================================================================

; ---- QSA KV cache（12 层）----
2 'KVE' !    ; KV 元素字节：2=FP16（默认）
'QL' @ 'MC' @ * 'KW' @ * 'KVE' @ * cuda.alloc 'kv.K' !    ; (QL, MC, KW) K 池
'QL' @ 'MC' @ * 'KW' @ * 'KVE' @ * cuda.alloc 'kv.V' !    ; (QL, MC, KW) V 池

; ============================================================================
; Session CPU 备份 —— GPU 侧递归态的 host 镜像，SS=4 份（'SS' @ 在 hash）
; 新提示词来了找最长可复用前缀命中的那份，tensor.copy 整份恢复回 GPU，
; ============================================================================

%for 0 3
'kv.K'       @ tensor.size host.alloc 'bak.%%.kv.K'       !
'kv.V'       @ tensor.size host.alloc 'bak.%%.kv.V'       !
%endf

; ============================================================================
; 同步内存 —— host↔device 共享控制块，一块 pinned（host.alloc / cudaHostAlloc）：
; host 直见，UVA 下 device 内核直接 deref 同一指针。不做 dev/host 双胞胎两块——
; cuda.alloc 的显存 host 看不见，那就只能逐拍搬字同步；控制块每拍就几十字节，
; 零拷贝直读直写才是它的本职。
; ============================================================================
; 布局：一块 (MC+5) 个 int32 = tokens 队列本体 + 5 字头。单会话、绝对坐标、
; 每字单写者（无锁）：
;   sync.tokens  tokens[0..MC)   待算 token 队列            host 写 / device 读
;                               prompt 到达、生成回填都落这里；backlog = tail - head
;   sync.head    tokens[MC+0]    第一个未计算 token 的绝对位（输入）
;   sync.tail    tokens[MC+1]    下一个新 token 落点，one-past-end（输入）
;   sync.next    tokens[MC+2]    drain 拍 argmax 出的 token id（输出）
;                               vocab 下标，不是位置：host 判 EOS、写协议行、回填
;                               队列全靠它；位置 host 自己有（= 当拍 head）
;   sync.flag    tokens[MC+3]    后续安排
;   sync.cmd     tokens[MC+4]    后续安排
; 头部初值（含清零）由 host 在会话建立时写——pinned 内容不保证清零。
; ============================================================================

'MC' @ 5 + 4 * host.alloc 'sync' !         ; tokens[MC] + 5 字头，一块 pinned
'MC' @ 4 * 'MCB' !                         ; MCB = MC*4：字头距块首的字节偏移
'sync' @ 0        'MCB' @       cuda.view 'sync.tokens' !  ; 队列本体 tokens[0..MC)
'sync' @ 'MCB' @                4 cuda.view 'sync.head'  !  ; [MC+0]
'sync' @ 'MCB' @ 4       +      4 cuda.view 'sync.tail'  !  ; [MC+1]
'sync' @ 'MCB' @ 8       +      4 cuda.view 'sync.next'  !  ; [MC+2]
'sync' @ 'MCB' @ 12      +      4 cuda.view 'sync.flag'  !  ; [MC+3]
'sync' @ 'MCB' @ 16      +      4 cuda.view 'sync.cmd'   !  ; [MC+4]

'sync' @ tensor.size cuda.alloc "sync.cuda" !   ; 对应的 H2D 的目标


; ---- 收尾：路径出栈，排空 H2D，报个到 ----
drop
cuda.sync
'qwen3.8-next loaded: 1078 dense weights (output≡token_embd Q6_K; PLE proj in; table on-demand) + memory resident' ?
