'blk.%%.attn_output.weight'    dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.attn_q.weight'         dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.attn_q_norm.weight'    dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.attn_v.weight'         dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.indexer.k_norm.weight' dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.indexer.k_proj.weight' dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.indexer.q_norm.weight' dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
