'blk.%%.hc_attn_inject.weight'     dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.hc_attn_norm.weight'       dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.hc_attn_up.weight'         dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
'blk.%%.hc_ffn_down.weight'        dup2 dup2 gguf.probe cuda.alloc gguf.load swap !
