; ============================================================================
; qwen3.8-next.vt —— Qwen3.8-Flash-Next 常驻小权重装载剧本（vt DSL）
;
; main 直接加载本剧本，装完进入 command loop 逐行执行 vt 指令（REPL）。
;
; 内存模型参照 Strata run-iq3_s.sh：小权重（attention/ssm/超连接/共享专家/
; 路由/output_hc）全数常驻显存；大块不装，留给后续按需路径——
;     token_embd.weight / output.weight   embedding/解嵌入（词表 248320）
;     blk.1.ple_*                         PLE 投影（6 个）
;     per_layer_token_embd.weight         PLE 巨表 28.8GB（在 00002 分片）
;     blk.*.ffn_*_exps.weight             MOE 专家（48 层 × 3）
;
; 装载模式（路径常驻栈底，逐张量复用）：
;     '名字' dup2 gguf.load swap !
;   dup2                ( path name -- path name path name )
;   gguf.load 吃一份    ( path name -- tensor )
;   swap !              ( tensor name -- ) 存进 hash；path 留栈
; 装完 drop 掉路径。合计 1071 个 =
;   3 顶层 output_hc + 48 层 × 13 公共 + 36 GDN 层 × 9 + 12 全注意力层 × 10
; ============================================================================

; ---- 模型路径（文件头直接设定；dup 一份进 hash 留档，REPL 里 'model.gguf' @ 随取）----
'/home/teaonly/workspace/models/qwen3.8-flash-gsq/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf' dup 'model.gguf' !

; ---- 顶层 output_hc（3 个）----
'output_hc_down.weight'  dup2 gguf.load swap !
'output_hc_norm.weight'  dup2 gguf.load swap !
'output_hc_up.weight'    dup2 gguf.load swap !

; ---- 48 层公共：FFN 共享专家 + 路由 + 超连接（13 个/层）----
%for 0 47
'blk.%%.ffn_down_shexp.weight'     dup2 gguf.load swap !
'blk.%%.ffn_gate_inp.weight'       dup2 gguf.load swap !
'blk.%%.ffn_gate_inp_shexp.weight' dup2 gguf.load swap !
'blk.%%.ffn_gate_shexp.weight'     dup2 gguf.load swap !
'blk.%%.ffn_up_shexp.weight'       dup2 gguf.load swap !
'blk.%%.hc_attn_down.weight'       dup2 gguf.load swap !
'blk.%%.hc_attn_inject.weight'     dup2 gguf.load swap !
'blk.%%.hc_attn_norm.weight'       dup2 gguf.load swap !
'blk.%%.hc_attn_up.weight'         dup2 gguf.load swap !
'blk.%%.hc_ffn_down.weight'        dup2 gguf.load swap !
'blk.%%.hc_ffn_inject.weight'      dup2 gguf.load swap !
'blk.%%.hc_ffn_norm.weight'        dup2 gguf.load swap !
'blk.%%.hc_ffn_up.weight'          dup2 gguf.load swap !
%endf

